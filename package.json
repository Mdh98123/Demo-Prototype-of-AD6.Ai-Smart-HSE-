{
  "name": "prototype1:-ad6.ai-smart-hse-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/health.test.mjs test/auth_regression.test.mjs test/pdf-export.test.mjs test/workflow.test.mjs test/workflow-server.test.mjs test/inspection_template.test.mjs test/ml_autotagger.test.mjs test/speech_commands.test.mjs test/inspection_pdf.test.mjs test/phase1_enterprise.test.mjs test/phase0_g3_regression.test.mjs test/phase1_postgres_tenancy.test.mjs test/phase2_statutory_clock_and_audit.test.mjs test/phase4_auth_rbac_sod_delegation.test.mjs",
    "test:phase4": "node --import tsx --test test/phase4_auth_rbac_sod_delegation.test.mjs",
    "test:phase2": "node --import tsx --test test/phase2_statutory_clock_and_audit.test.mjs",
    "test:phase1": "node --import tsx --test test/phase1_postgres_tenancy.test.mjs",
    "test:g3": "node --import tsx --test test/phase0_g3_regression.test.mjs",
    "preview": "vite preview",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run lint"
    ]
  },
  "dependencies": {
    "@google-cloud/logging": "11.4.0",
    "@google/genai": "1.42.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/pg": "^8.23.1",
    "browser-image-compression": "2.0.2",
    "canvas-confetti": "1.9.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "firebase": "12.12.0",
    "framer-motion": "11.15.0",
    "glob": "13.0.6",
    "i18next": "26.0.6",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "8.0.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "lucide-react": "0.561.0",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "17.0.4",
    "react-leaflet": "5.0.0",
    "react-markdown": "10.1.0",
    "recharts": "3.8.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "2.5.5",
    "xlsx": "0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.heat": "0.2.5",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
