# ==============================================================================
# AD6 HSE Enterprise AI Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Node Runtime Environment ('development' | 'production')
NODE_ENV=development

# Server Port (Default in development: 3000; Default in production: 8080)
PORT=3000

# Authentication Architecture Mode ('demo' | 'firebase' | 'enterprise')
AUTH_MODE=demo
VITE_AUTH_MODE=demo

# Demonstration Mode Feature Flag ('true' | 'false')
DEMO_MODE=true
VITE_DEMO_MODE=true

# Workflow linking requires both server flags and the client setting to be enabled.
# Workflow traffic is limited to synthetic demo sessions and is not operational authentication.
WORKFLOW_LINKING=false
VITE_WORKFLOW_LINKING=false
# Optional stable secret for synthetic workflow demo credentials. If omitted, tokens expire on restart.
WORKFLOW_DEMO_TOKEN_SECRET=

# Google Gemini API Key (Required for Safi AI Copilot, RCA analysis, SIF prediction, audio transcription, ESG narrative generation)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Regional Statutory Integration Tokens (Sultanate of Oman connectors)
MOL_OMAN_API_TOKEN=
PDO_SAFETY_TOKEN=

# Firebase Client Configuration (Optional; fallback defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
