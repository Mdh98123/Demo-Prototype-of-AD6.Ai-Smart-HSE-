# ==============================================================================
# AD6 HSE Enterprise AI Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================================

# Node Runtime Environment ('development' | 'production')
NODE_ENV=development

# Server Port (Default in development: 3000; Default in production: 8080)
PORT=3000

# Authentication Architecture Mode ('demo' | 'firebase' | 'enterprise')
AUTH_MODE=demo
VITE_AUTH_MODE=demo

# Demonstration Mode Feature Flag ('true' | 'false')
DEMO_MODE=true
VITE_DEMO_MODE=true

# ==============================================================================
# Phase-Driven Enterprise Feature Flags (Defaults to false in Phase 0)
# ==============================================================================
FEATURE_FLAG_DURABLE_PERSISTENCE=false
FEATURE_FLAG_STATUTORY_CLOCK=false
FEATURE_FLAG_AUDIT_LOG_V2=false
FEATURE_FLAG_SOD_DB_ENFORCED=false
FEATURE_FLAG_AI_GATES=false
FEATURE_FLAG_OFFLINE_SYNC_V2=false
FEATURE_FLAG_INTEGRATIONS=false

# Workflow linking requires both server flags and the client setting to be enabled.
WORKFLOW_LINKING=false
VITE_WORKFLOW_LINKING=false
WORKFLOW_DEMO_TOKEN_SECRET=

# Google Gemini API Key (Required for Safi AI Copilot, RCA analysis, SIF prediction)
GEMINI_API_KEY=

# Regional Statutory Intelligence (Sultanate of Oman & GCC)
# Channel selection mode: 'simulated' (deterministic sandbox) or 'live' (official MoL portal)
STATUTORY_CHANNEL_MODE=simulated
OMAN_MOL_API_ENDPOINT=https://api.mol.gov.om/v1/hse/notifications
OMAN_MOL_API_KEY=

# PostgreSQL 16 Enterprise Relational Database (Multi-Tenant with Row-Level Security)
DATABASE_URL=postgresql://hse_admin:hse_secure_password_2026@localhost:5432/ad6_hse_enterprise?sslmode=disable

# S3-Compatible Object Storage (MinIO / AWS S3 / Cloud Storage for Evidence & Form G PDFs)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ad6_minio_admin
S3_SECRET_KEY=
S3_BUCKET_EVIDENCE=ad6-hse-evidence

# Firebase Client Configuration (Optional; fallback defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
