// Strategic Architecture: Database Models & Row-Level Security (RLS) Specification
// Target: PostgreSQL 16
// Framework: Prisma ORM with RLS extensions

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "clientMetrics"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pgcrypto(map: "pgcrypto")]
}

// -----------------------------------------------------------------------------
// 1. TENANCY & USERS
// -----------------------------------------------------------------------------
model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(64)
  name             String   @db.VarChar(255)
  jurisdiction     String   @default("OMAN") @db.VarChar(32)
  crNumber         String   @map("cr_number") @db.VarChar(128)
  dataResidency    String   @default("OMAN_CLOUD") @map("data_residency") @db.VarChar(64)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sites            Site[]
  users            User[]
  roles            Role[]
  roleAssignments  RoleAssignment[]
  contractors      Contractor[]
  competencyRecs   CompetencyRecord[]
  incidents        Incident[]
  capas            Capa[]
  permits          Permit[]
  twlReadings      TwlReading[]
  inspections      Inspection[]
  observations     Observation[]
  hazardReports    HazardReport[]
  trainingRecords  TrainingRecord[]
  documents        Document[]
  obligations      RegulatoryObligation[]
  submissions      Submission[]
  auditLogs        AuditLog[]
  aiOutputs        AiOutput[]

  @@map("tenants")
}

model Site {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String   @db.VarChar(64)
  name        String   @db.VarChar(255)
  location    String   @db.VarChar(255)
  coordinates Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  twlReadings TwlReading[]

  @@index([tenantId])
  @@map("sites")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  role         String   @db.VarChar(64)
  department   String?  @db.VarChar(128)
  ssoSubjectId String?  @map("sso_subject_id") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  roleAssignments RoleAssignment[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(128)
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  roleAssignments RoleAssignment[]

  @@index([tenantId])
  @@map("roles")
}

model RoleAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("role_assignments")
}

// -----------------------------------------------------------------------------
// 2. CONTRACTORS & COMPETENCY
// -----------------------------------------------------------------------------
model Contractor {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName      String   @map("company_name") @db.VarChar(255)
  trade            String   @db.VarChar(128)
  contactEmail     String?  @map("contact_email") @db.VarChar(255)
  contactPhone     String?  @map("contact_phone") @db.VarChar(64)
  complianceStatus String   @default("Approved") @map("compliance_status") @db.VarChar(64)
  crNumber         String?  @map("cr_number") @db.VarChar(128)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  documents        ContractorDocument[]

  @@index([tenantId])
  @@map("contractors")
}

model ContractorDocument {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  docType      String     @map("doc_type") @db.VarChar(128)
  title        String     @db.VarChar(255)
  fileUrl      String     @map("file_url")
  expiryDate   DateTime?  @map("expiry_date") @db.Date
  status       String     @default("Valid") @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("contractor_documents")
}

model CompetencyRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workerName    String   @map("worker_name") @db.VarChar(255)
  civilId       String   @map("civil_id") @db.VarChar(128)
  trade         String   @db.VarChar(128)
  certification String   @db.VarChar(255)
  issuer        String   @db.VarChar(255)
  issueDate     DateTime @map("issue_date") @db.Date
  expiryDate    DateTime @map("expiry_date") @db.Date
  verified      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("competency_records")
}

// -----------------------------------------------------------------------------
// 3. INCIDENTS, INVESTIGATIONS & RCA
// -----------------------------------------------------------------------------
model Incident {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentNumber     String   @map("incident_number") @db.VarChar(64)
  title              String   @db.VarChar(255)
  description        String   @default("")
  severity           String   @db.VarChar(32)
  status             String   @default("Open") @db.VarChar(32)
  location           String   @db.VarChar(255)
  incidentTimestamp  DateTime @default(now()) @map("incident_timestamp") @db.Timestamptz
  formGSubmitted     Boolean  @default(false) @map("form_g_submitted")
  formGReceiptNumber String?  @map("form_g_receipt_number") @db.VarChar(128)
  formGDeadline      DateTime? @map("form_g_deadline") @db.Timestamptz
  details            Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  evidence           IncidentEvidence[]
  investigations     Investigation[]

  @@index([tenantId])
  @@map("incidents")
}

model IncidentEvidence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type") @db.VarChar(64)
  caption    String?
  uploadedBy String?  @map("uploaded_by") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("incident_evidence")
}

model Investigation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentId        String   @map("incident_id") @db.Uuid
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  leadInvestigator  String   @map("lead_investigator") @db.VarChar(255)
  status            String   @default("In Progress") @db.VarChar(64)
  rootCauseSummary  String?  @map("root_cause_summary")
  methodology       String   @default("5-Whys and Fishbone") @db.VarChar(128)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  whys              Why[]
  fishboneNodes     FishboneNode[]
  bowtieNodes       BowtieNode[]

  @@index([tenantId])
  @@map("investigations")
}

model Why {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigationId String        @map("investigation_id") @db.Uuid
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  level           Int
  question        String
  answer          String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("whys")
}

model FishboneNode {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigationId String        @map("investigation_id") @db.Uuid
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  category        String        @db.VarChar(64)
  cause           String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("fishbone_nodes")
}

model BowtieNode {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  investigationId String        @map("investigation_id") @db.Uuid
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  nodeType        String        @map("node_type") @db.VarChar(64)
  description     String
  barrierType     String?       @map("barrier_type") @db.VarChar(64)
  status          String        @default("Effective") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("bowtie_nodes")
}

// -----------------------------------------------------------------------------
// 4. CAPAS
// -----------------------------------------------------------------------------
model Capa {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionNumber   String   @map("action_number") @db.VarChar(64)
  title          String   @db.VarChar(255)
  description    String   @default("")
  priority       String   @default("P2 - High") @db.VarChar(32)
  status         String   @default("Open") @db.VarChar(32)
  ownerName      String   @map("owner_name") @db.VarChar(255)
  verifiedByName String?  @map("verified_by_name") @db.VarChar(255)
  dueDate        DateTime @map("due_date") @db.Date
  hierarchy      String   @default("Engineering") @db.VarChar(64)
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  evidence       CapaEvidence[]

  @@index([tenantId])
  @@map("capas")
}

model CapaEvidence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capaId      String   @map("capa_id") @db.Uuid
  capa        Capa     @relation(fields: [capaId], references: [id], onDelete: Cascade)
  fileUrl     String   @map("file_url")
  description String?
  uploadedBy  String?  @map("uploaded_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("capa_evidence")
}

// -----------------------------------------------------------------------------
// 5. PERMITS (PTW, ISOLATIONS, GAS TESTS)
// -----------------------------------------------------------------------------
model Permit {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitNumber      String   @map("permit_number") @db.VarChar(64)
  permitType        String   @map("permit_type") @db.VarChar(64)
  status            String   @default("Pending") @db.VarChar(32)
  zone              String   @default("General Area") @db.VarChar(128)
  exactLocation     String   @map("exact_location") @db.VarChar(255)
  validFrom         DateTime @default(now()) @map("valid_from") @db.Timestamptz
  validTo           DateTime @map("valid_to") @db.Timestamptz
  issuerName        String?  @map("issuer_name") @db.VarChar(255)
  receiverName      String?  @map("receiver_name") @db.VarChar(255)
  issuerSignature   Json?    @map("issuer_signature")
  receiverSignature Json?    @map("receiver_signature")
  details           Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  approvals         PermitApproval[]
  isolations        PermitIsolation[]
  gasTests          GasTest[]

  @@index([tenantId])
  @@map("permits")
}

model PermitApproval {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitId     String   @map("permit_id") @db.Uuid
  permit       Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approverName String   @map("approver_name") @db.VarChar(255)
  approverRole String   @map("approver_role") @db.VarChar(128)
  status       String   @default("Approved") @db.VarChar(32)
  comments     String?
  signedAt     DateTime @default(now()) @map("signed_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("permit_approvals")
}

model PermitIsolation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitId      String   @map("permit_id") @db.Uuid
  permit        Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  isolationType String   @map("isolation_type") @db.VarChar(64)
  tagNumber     String   @map("tag_number") @db.VarChar(128)
  isolatedBy    String   @map("isolated_by") @db.VarChar(255)
  verifiedBy    String?  @map("verified_by") @db.VarChar(255)
  status        String   @default("Active") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("permit_isolations")
}

model GasTest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitId   String   @map("permit_id") @db.Uuid
  permit     Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  testerName String   @map("tester_name") @db.VarChar(255)
  oxygenPct  Decimal  @map("oxygen_pct") @db.Decimal(4, 2)
  lelPct     Decimal  @map("lel_pct") @db.Decimal(4, 2)
  h2sPpm     Decimal  @map("h2s_ppm") @db.Decimal(5, 2)
  coPpm      Decimal  @map("co_ppm") @db.Decimal(5, 2)
  passed     Boolean  @default(true)
  testedAt   DateTime @default(now()) @map("tested_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("gas_tests")
}

// -----------------------------------------------------------------------------
// 6. TWL (THERMAL WORK LIMIT)
// -----------------------------------------------------------------------------
model TwlReading {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId          String?     @map("site_id") @db.Uuid
  site            Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location        String      @db.VarChar(255)
  dryBulbC        Decimal     @map("dry_bulb_c") @db.Decimal(4, 1)
  wetBulbC        Decimal     @map("wet_bulb_c") @db.Decimal(4, 1)
  globeTempC      Decimal     @map("globe_temp_c") @db.Decimal(4, 1)
  twlWM2          Decimal     @map("twl_w_m2") @db.Decimal(5, 1)
  workRestRegime  String      @map("work_rest_regime") @db.VarChar(128)
  flagColor       String      @map("flag_color") @db.VarChar(32)
  recordedAt      DateTime    @default(now()) @map("recorded_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  breaches        TwlBreach[]

  @@index([tenantId])
  @@map("twl_readings")
}

model TwlBreach {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId             String?     @map("site_id") @db.Uuid
  readingId          String?     @map("reading_id") @db.Uuid
  reading            TwlReading? @relation(fields: [readingId], references: [id], onDelete: SetNull)
  twlValue           Decimal     @map("twl_value") @db.Decimal(5, 1)
  breachType         String      @map("breach_type") @db.VarChar(64)
  stopWorkTriggered  Boolean     @default(true) @map("stop_work_triggered")
  resolvedAt         DateTime?   @map("resolved_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("twl_breaches")
}

// -----------------------------------------------------------------------------
// 7. INSPECTIONS & OBSERVATIONS
// -----------------------------------------------------------------------------
model Inspection {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String   @db.VarChar(255)
  templateType  String   @map("template_type") @db.VarChar(128)
  siteName      String   @map("site_name") @db.VarChar(255)
  inspectorName String   @map("inspector_name") @db.VarChar(255)
  status        String   @default("Scheduled") @db.VarChar(32)
  score         Decimal? @db.Decimal(5, 2)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  details       Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items         InspectionItem[]

  @@index([tenantId])
  @@map("inspections")
}

model InspectionItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspectionId String     @map("inspection_id") @db.Uuid
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category     String     @db.VarChar(128)
  itemText     String     @map("item_text")
  status       String     @default("Compliant") @db.VarChar(32)
  notes        String?
  photoUrl     String?    @map("photo_url")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("inspection_items")
}

model Observation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  observationNumber String   @map("observation_number") @db.VarChar(64)
  observerName      String   @map("observer_name") @db.VarChar(255)
  observationType   String   @map("observation_type") @db.VarChar(64)
  location          String   @db.VarChar(255)
  description       String
  immediateAction   String?  @map("immediate_action")
  status            String   @default("Logged") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@map("observations")
}

model HazardReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hazardNumber   String   @map("hazard_number") @db.VarChar(64)
  reporterName   String   @map("reporter_name") @db.VarChar(255)
  hazardCategory String   @map("hazard_category") @db.VarChar(128)
  riskLevel      String   @map("risk_level") @db.VarChar(32)
  description    String
  location       String   @db.VarChar(255)
  status         String   @default("Open") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@map("hazard_reports")
}

// -----------------------------------------------------------------------------
// 8. TRAINING & DOCUMENTS
// -----------------------------------------------------------------------------
model TrainingRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseTitle    String    @map("course_title") @db.VarChar(255)
  courseCode     String    @map("course_code") @db.VarChar(64)
  traineeName    String    @map("trainee_name") @db.VarChar(255)
  civilId        String    @map("civil_id") @db.VarChar(128)
  completionDate DateTime  @map("completion_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  score          Decimal?  @db.Decimal(5, 2)
  certificateUrl String?   @map("certificate_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("training_records")
}

model Document {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  docNumber      String   @map("doc_number") @db.VarChar(64)
  title          String   @db.VarChar(255)
  category       String   @db.VarChar(128)
  status         String   @default("Active") @db.VarChar(32)
  currentVersion String   @default("1.0") @map("current_version") @db.VarChar(32)
  ownerName      String   @map("owner_name") @db.VarChar(255)
  fileUrl        String   @map("file_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  revisions      DocumentRevision[]

  @@index([tenantId])
  @@map("documents")
}

model DocumentRevision {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String    @map("document_id") @db.Uuid
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionString String    @map("version_string") @db.VarChar(32)
  changeSummary String    @map("change_summary")
  authorName    String    @map("author_name") @db.VarChar(255)
  fileUrl       String    @map("file_url")
  approvedBy    String?   @map("approved_by") @db.VarChar(255)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("document_revisions")
}

// -----------------------------------------------------------------------------
// 9. REGULATORY OBLIGATIONS & CONTROL MAPPINGS
// -----------------------------------------------------------------------------
model RegulatoryObligation {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  standardCode        String   @map("standard_code") @db.VarChar(64)
  title               String   @db.VarChar(255)
  issuingBody         String   @map("issuing_body") @db.VarChar(255)
  jurisdiction        String   @default("OMAN") @db.VarChar(32)
  complianceLevel     String   @default("Full Compliance") @map("compliance_level") @db.VarChar(64)
  reviewFrequency     String   @default("Annual") @map("review_frequency") @db.VarChar(64)
  lastAuditedAt       DateTime? @map("last_audited_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  controlMappings     ControlMapping[]

  @@index([tenantId])
  @@map("regulatory_obligations")
}

model ControlMapping {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obligationId          String?              @map("obligation_id") @db.Uuid
  obligation            RegulatoryObligation? @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  internalControlRef    String               @map("internal_control_ref") @db.VarChar(128)
  controlDescription    String               @map("control_description")
  verificationFrequency String               @default("Monthly") @map("verification_frequency") @db.VarChar(64)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("control_mappings")
}

// -----------------------------------------------------------------------------
// 10. SUBMISSIONS, AUDIT LOG & AI OUTPUTS
// -----------------------------------------------------------------------------
model Submission {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionType   String   @map("submission_type") @db.VarChar(64)
  referenceNumber  String   @map("reference_number") @db.VarChar(128)
  targetAuthority  String   @map("target_authority") @db.VarChar(128)
  payload          Json     @default("{}")
  receipt          Json?
  status           String   @default("Submitted") @db.VarChar(64)
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("submissions")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId     String   @map("actor_id") @db.VarChar(128)
  actorRole   String   @map("actor_role") @db.VarChar(128)
  action      String   @db.VarChar(128)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String   @map("entity_id") @db.VarChar(128)
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  entryHash   String   @map("entry_hash") @db.VarChar(64)
  signature   String?  @db.VarChar(256)
  timestamp   DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("audit_log")
}

model AiOutput {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelAlias      String    @map("model_alias") @db.VarChar(128)
  promptHash      String    @map("prompt_hash") @db.VarChar(64)
  outputText      String    @map("output_text")
  confidenceScore Decimal?  @map("confidence_score") @db.Decimal(5, 4)
  hitlStatus      String    @default("Pending_Review") @map("hitl_status") @db.VarChar(64)
  reviewedBy      String?   @map("reviewed_by") @db.VarChar(255)
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@map("ai_outputs")
}
